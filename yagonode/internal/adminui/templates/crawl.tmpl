{{define "content"}}
<nav class="cds-breadcrumb" aria-label="Breadcrumb"><a href="/admin/overview">Admin</a> / Crawler</nav>
<h1 class="cds-h1">Crawler</h1>
<p class="cds-muted">Submit focused seed URLs for the crawler. The node records the topic and URLs; the crawler owns its persistent frontier and chooses when and in what order to fetch them.</p>
{{with .Monitor}}{{template "crawl-monitor" .}}{{end}}
{{if .Error}}
<div class="cds-inline-notification cds-inline-notification--error" role="alert">{{.Error}}</div>
{{end}}
{{if .Section.Message}}
<div class="cds-inline-notification cds-inline-notification--success" role="status">{{.Section.Message}}</div>
{{end}}
{{with .Result}}
<div class="cds-inline-notification cds-inline-notification--success" role="status">{{.Seeds}} focused seed URL(s) recorded for the crawler under topic <code>{{.ProfileHandle}}</code>.</div>
{{end}}
<form class="cds-form" method="post" action="/admin/crawl" hx-boost="false">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <div class="cds-field">
    <label class="cds-label" for="seeds">Seed URLs (one per line)</label>
    <textarea class="cds-input cds-textarea" id="seeds" name="seeds" rows="4" autocomplete="off" required>{{.Form.Seeds}}</textarea>
  </div>
  <div class="cds-field">
    <label class="cds-label" for="name">Topic (optional)</label>
    <input class="cds-input" type="text" id="name" name="name" value="{{.Form.Name}}" autocomplete="off">
  </div>
  <div class="cds-control-row">
    <button class="cds-btn" type="submit">Submit focused seeds</button>
  </div>
</form>

{{end}}
